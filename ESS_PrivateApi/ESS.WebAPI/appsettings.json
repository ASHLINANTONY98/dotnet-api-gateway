{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*", //chnage this before deployment for dont use unknown hosts

  // JWT settings for external clients
  "JwtSettings": {
    "Issuer": "ESS.PublicApi",
    "Audience": "ESS.Clients",
    "ExpiresInMinutes": 15
  },

