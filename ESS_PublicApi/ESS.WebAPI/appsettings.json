{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  // JWT settings for external clients
  "JwtSettings": {
    "Key": "$2a$11$ZT2J9PUh34ay9w7Wh5JNLeENLz3n.GzcXr8k.Cp6GjIoaDat.9MBO",
    "Issuer": "ESS.PublicApi",
    "Audience": "ESS.Clients",
    "ExpiresInMinutes": 60
  },

  // URL of private API
  "PrivateApi": {
    "BaseUrl": "https://localhost:7023" //local
    //"BaseUrl": "https://uatapp.manappuram.net/API_ESSAPP_VENDOR_VALIDATION/" //uat
