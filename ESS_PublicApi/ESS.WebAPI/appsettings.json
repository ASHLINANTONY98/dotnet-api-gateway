{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  // JWT settings for external clients
  "JwtSettings": {
    "Issuer": "ESS.PublicApi",
    "Audience": "ESS.Clients"
  },

